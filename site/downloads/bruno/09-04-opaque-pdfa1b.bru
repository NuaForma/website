meta {
  name: PDF/A-1b without a watermark
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  request: @file(assets/04-opaque-pdfa1b.json) @contentType(application/json)
  template: @file(assets/nuaforma-example-template.docx) @contentType(application/vnd.openxmlformats-officedocument.wordprocessingml.document)
}

headers {
  Accept: application/pdf
}

assert {
  res.status: eq 200
}

docs {
  Opaque images and no requested watermark. Every requested watermark is rejected for PDF/A-1b. Expected: Independently validated PDF/A-1b; no watermark or transparency flattening. The historical download filename is retained.
  Save a successful document response as PDF or DOCX. Errors are JSON diagnostics.
}
